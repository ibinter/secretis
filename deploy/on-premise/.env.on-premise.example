# =============================================================================
# SECRETIS ERP — Variables d'environnement On-Premise
# Copiez ce fichier vers .env et renseignez toutes les valeurs marquées REQUIRED
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="SECRETIS ERP"
APP_ENV=production
APP_DEBUG=false
# REQUIRED — Généré automatiquement par install.sh : php artisan key:generate --show
APP_KEY=
# REQUIRED — Votre domaine complet (avec https://)
APP_URL=https://secretis.monentreprise.com
APP_LOCALE=fr
APP_TIMEZONE=Europe/Paris

# Mode déploiement
DEPLOYMENT_MODE=on-premise

# REQUIRED — Clé de licence On-Premise fournie par IBIG Soft
SECRETIS_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX

# -----------------------------------------------------------------------------
# BASE DE DONNÉES — PostgreSQL
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# REQUIRED
DB_DATABASE=secretis
# REQUIRED
DB_USERNAME=secretis
# REQUIRED — Utilisez un mot de passe fort (min 32 caractères)
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_SCHEMA=public
# Pool de connexions
DB_POOL_MIN=2
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# REDIS — Cache + Sessions + Queues
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED — Mot de passe Redis fort
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# -----------------------------------------------------------------------------
# SESSIONS
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

# -----------------------------------------------------------------------------
# CACHE
# -----------------------------------------------------------------------------
CACHE_DRIVER=redis
CACHE_PREFIX=secretis_

# -----------------------------------------------------------------------------
# QUEUES
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90
HORIZON_PREFIX=secretis_

# -----------------------------------------------------------------------------
# STOCKAGE FICHIERS — MinIO (S3-compatible)
# Choisir : minio (recommandé) ou local
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=minio

# Stockage local (si FILESYSTEM_DISK=local)
# Les fichiers sont dans storage/app

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=secretis-admin
# REQUIRED si FILESYSTEM_DISK=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_USERNAME=secretis-app
# REQUIRED si FILESYSTEM_DISK=minio
MINIO_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD
MINIO_BUCKET=secretis-documents
MINIO_BACKUP_BUCKET=secretis-backups
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Alias S3 pour Laravel (utilise MinIO)
AWS_ACCESS_KEY_ID=${MINIO_USERNAME}
AWS_SECRET_ACCESS_KEY=${MINIO_PASSWORD}
AWS_DEFAULT_REGION=${MINIO_REGION}
AWS_BUCKET=${MINIO_BUCKET}
AWS_ENDPOINT=${MINIO_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# WEBSOCKETS — Laravel Reverb
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=reverb
REVERB_APP_ID=secretis-onpremise
# REQUIRED — Généré par : php artisan reverb:generate-secret
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
# REQUIRED
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# URL publique WebSocket (utilisée côté client)
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${APP_URL}
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# -----------------------------------------------------------------------------
# NOTIFICATIONS PUSH — VAPID (Web Push)
# -----------------------------------------------------------------------------
# REQUIRED — Généré par : php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# EMAIL (configuré par l'administrateur On-Premise)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
# REQUIRED — Serveur SMTP de votre organisation
MAIL_HOST=smtp.monentreprise.com
MAIL_PORT=587
MAIL_USERNAME=secretis@monentreprise.com
# REQUIRED
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=secretis@monentreprise.com
MAIL_FROM_NAME="${APP_NAME}"

# Email administrateur pour les alertes système
ADMIN_EMAIL=admin@monentreprise.com

# -----------------------------------------------------------------------------
# FOURNISSEURS IA (optionnels)
# Laissez vide pour désactiver la fonctionnalité IA correspondante
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# Fournisseur actif : openai | anthropic | google | none
AI_DEFAULT_PROVIDER=none
AI_ENABLED=false

# -----------------------------------------------------------------------------
# SÉCURITÉ
# -----------------------------------------------------------------------------
# Durée de vie des tokens API (en minutes, 0 = illimité)
SANCTUM_EXPIRATION=0
# 2FA obligatoire pour les admins
FORCE_2FA_ADMINS=true
# IP autorisées pour l'interface admin (vide = toutes)
ADMIN_ALLOWED_IPS=

# Rate limiting
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=10

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=warning
LOG_MAX_FILES=30

# -----------------------------------------------------------------------------
# MONITORING (optionnel)
# -----------------------------------------------------------------------------
# Endpoint Prometheus /metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_NAMESPACE=secretis

# Sentry (optionnel)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# SAUVEGARDE
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
# Destinations : local, s3, sftp, ftp
BACKUP_DESTINATION=local
BACKUP_LOCAL_PATH=/backups

# S3 externe (optionnel)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# SFTP externe (optionnel)
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_PATH=/backups/secretis

# Chiffrement des sauvegardes
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY_32CHARS

# Rétention
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# -----------------------------------------------------------------------------
# PERFORMANCE
# -----------------------------------------------------------------------------
OPCACHE_ENABLE=1
OPCACHE_MEMORY=256
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_SIZE=50M
