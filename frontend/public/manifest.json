{
  "name": "IBIG SECRETIS — ERP Secrétariat",
  "short_name": "SECRETIS",
  "description": "Système de gestion de secrétariat et d'administration pour l'Afrique",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
