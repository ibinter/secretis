    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-dashboard.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tableau de bord SECRETIS"
    },
    {
      "src": "/screenshots/mobile-agenda.png",
      "sizes": "375x812",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Agenda mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouvel événement",
      "short_name": "Événement",
      "description": "Créer un événement dans l'agenda",
      "url": "/agenda/create",
      "icons": [{ "src": "/icons/shortcut-agenda.png", "sizes": "96x96" }]
    },
    {
      "name": "Mes tâches",
      "short_name": "Tâches",
      "description": "Consulter et gérer mes tâches",
      "url": "/taches",
      "icons": [{ "src": "/icons/shortcut-taches.png", "sizes": "96x96" }]
    },
    {
      "name": "Visiteurs",
      "short_name": "Visiteurs",
      "description": "Accueil et gestion des visiteurs",
      "url": "/accueil/visiteurs",
      "icons": [{ "src": "/icons/shortcut-nouveau.png", "sizes": "96x96" }]
    },
    {
      "name": "SARA",
      "short_name": "SARA",
      "description": "Parler à l'assistant IA SARA",
      "url": "/sara/chat",
      "icons": [{ "src": "/icons/shortcut-courrier.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/ged/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "document",
          "accept": ["application/pdf", "image/*", ".docx", ".xlsx", ".doc", ".xls"]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ibigsoft.secretis"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/ibig-secretis/id0000000000"
    }
  ],
  "prefer_related_applications": false
}
