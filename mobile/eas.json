{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "API_BASE_URL": "https://dev-api.secretis.ibigsoft.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "API_BASE_URL": "https://staging-api.secretis.ibigsoft.com"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "API_BASE_URL": "https://api.secretis.ibigsoft.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
