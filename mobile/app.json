{
  "expo": {
    "name": "IBIG SECRETIS",
    "slug": "secretis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1A3A5C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A5C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibigsoft.secretis",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "SECRETIS utilise la caméra pour scanner des documents et mettre à jour votre photo de profil.",
        "NSPhotoLibraryUsageDescription": "SECRETIS accède à votre galerie pour joindre des fichiers aux messages et tâches.",
        "NSFaceIDUsageDescription": "SECRETIS utilise Face ID pour sécuriser votre connexion.",
        "NSLocationWhenInUseUsageDescription": "SECRETIS peut utiliser votre localisation pour les événements."
      },
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A5C"
      },
      "package": "com.ibigsoft.secretis",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3A5C",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SECRETIS utilise la caméra pour scanner des documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Utiliser Face ID pour se connecter à SECRETIS."
        }
      ],
      "expo-secure-store",
      [
        "react-native-mmkv",
        {}
      ]
    ],
    "scheme": "secretis",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "ibigsoft"
  }
}
