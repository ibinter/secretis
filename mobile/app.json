{
  "expo": {
    "name": "IBIG SECRETIS",
    "slug": "ibig-secretis",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1A3A5C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A5C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibigsoft.secretis",
      "buildNumber": "200",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SECRETIS utilise Face ID pour vous connecter rapidement et en toute sécurité.",
        "NSCameraUsageDescription": "SECRETIS utilise la caméra pour scanner les QR codes de documents.",
        "NSPhotoLibraryUsageDescription": "SECRETIS accède à votre galerie pour joindre des photos aux documents.",
        "NSLocationWhenInUseUsageDescription": "SECRETIS peut utiliser votre localisation pour les événements."
      },
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A5C"
      },
      "package": "com.ibigsoft.secretis",
      "versionCode": 200,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3A5C",
          "sounds": ["./assets/notification.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SECRETIS utilise la caméra pour scanner des documents."
        }
      ],
      [
        "react-native-mmkv",
        {}
      ]
    ],
    "scheme": "secretis",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "ibigsoft"
  }
}
