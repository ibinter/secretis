{
  "expo": {
    "name": "IBIG SECRETIS",
    "slug": "ibig-secretis",
    "version": "2.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1A3A5C",
    "scheme": "secretis",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3A5C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibigsoft.secretis",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SECRETIS utilise Face ID pour sécuriser votre accès.",
        "NSCameraUsageDescription": "SECRETIS utilise la caméra pour scanner des documents et les QR codes.",
        "NSPhotoLibraryUsageDescription": "SECRETIS accède à votre galerie pour joindre des documents.",
        "NSLocalNetworkUsageDescription": "SECRETIS peut se connecter à votre réseau local.",
        "NSContactsUsageDescription": "SECRETIS accède aux contacts pour inviter des collègues.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "associatedDomains": [
        "applinks:app.secretis.ibigsoft.com"
      ],
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A5C"
      },
      "package": "com.ibigsoft.secretis",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.secretis.ibigsoft.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "SECRETIS utilise la caméra pour numériser vos documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3A5C",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      "expo-secure-store",
      "expo-file-system",
      "expo-sharing",
      "@react-native-async-storage/async-storage"
    ],
    "extra": {
      "eas": {
        "projectId": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "channel": "production"
    },
    "owner": "ibigsoft"
  }
}
