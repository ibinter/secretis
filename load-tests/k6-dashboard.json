          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 40,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_login_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Login p95",
          "refId":      "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_dashboard_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Dashboard p95",
          "refId":      "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_create_event_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Créer événement p95",
          "refId":      "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_create_task_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Créer tâche p95",
          "refId":      "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_upload_doc_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Upload doc p95",
          "refId":      "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_step_send_message_duration_bucket{job=\"k6\"}[1m]))",
          "legendFormat":"Message p95",
          "refId":      "F"
        }
      ],
      "title": "Durée p95 par étape du parcours (Full Journey)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 41,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "k6_journey_success_rate{job=\"k6\"}",
          "legendFormat":"Taux succès parcours",
          "refId":      "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "k6_isolation_check_passed{job=\"k6\"}",
          "legendFormat":"Isolation multi-tenant",
          "refId":      "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "k6_cache_hit_rate{job=\"k6\"}",
          "legendFormat":"Cache Redis hit rate",
          "refId":      "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "k6_idempotency_respected{job=\"k6\"}",
          "legendFormat":"Idempotence webhook",
          "refId":      "D"
        }
      ],
      "title": "Taux de succès – métriques métier",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 105,
      "title": "Comparaison avec les seuils cibles",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red",    "value": 500 }
            ]
          },
          "unit": "ms",
          "min": 0,
          "max": 1000
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 42 },
      "id": 50,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation":   "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "histogram_quantile(0.95, rate(k6_http_req_duration_bucket{job=\"k6\"}[5m]))",
          "legendFormat":"p95 actuel",
          "refId":      "A"
        }
      ],
      "title": "Jauge p95 (seuil : 500ms)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red",    "value": 0.01 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 0.05
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 42 },
      "id": 51,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr":       "rate(k6_http_req_failed_total{job=\"k6\"}[5m]) / rate(k6_http_reqs_total{job=\"k6\"}[5m])",
          "legendFormat":"Taux erreur",
          "refId":      "A"
        }
      ],
      "title": "Jauge taux d'erreur (seuil : 1%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red",    "value": 1000 }
            ]
          },
          "unit": "ms",
          "min": 0,
          "max": 2000
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 42 },
