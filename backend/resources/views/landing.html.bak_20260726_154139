<script>
// ─── Mobile menu ─────────────────────────────────────────────
function toggleMenu() {
  const m = document.getElementById('mobile-menu');
  const b = document.getElementById('ham-btn');
  const open = m.classList.toggle('open');
  b.setAttribute('aria-expanded', open);
  document.body.style.overflow = open ? 'hidden' : '';
}
document.getElementById('mobile-menu')?.addEventListener('keydown', e => {
  if (e.key === 'Escape') toggleMenu();
});

// ─── Header compact on scroll ─────────────────────────────────
let topbarH = document.querySelector('.topbar')?.offsetHeight || 0;
// When scrolled past topbar, fix header at top-0 instead of behind topbar
// (topbar is not fixed, so header needs to compensate)

// ─── SARA modal ────────────────────────────────────────────────
function openSara() { document.getElementById('sara-modal').classList.add('open'); }
function closeSara() { document.getElementById('sara-modal').classList.remove('open'); }
function saraSend(el) {
  const txt = el.textContent;
  addMsg(txt, 'user');
  setTimeout(() => addBotReply(txt), 600);
}
function sendSara() {
  const inp = document.getElementById('sara-input');
  const txt = inp.value.trim();
  if (!txt) return;
  inp.value = '';
  addMsg(txt, 'user');
  setTimeout(() => addBotReply(txt), 700);
}
function addMsg(text, type) {
  const box = document.getElementById('sara-messages');
  const div = document.createElement('div');
  div.className = 'sara-msg ' + type;
  div.textContent = text;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}
function addBotReply(q) {
  if (window.saraAskApi) {
    const box = document.getElementById('sara-messages');
    const typing = document.createElement('div');
    typing.className = 'sara-msg bot';
    typing.textContent = '…';
    box.appendChild(typing);
    box.scrollTop = box.scrollHeight;
    window.saraAskApi(q, function (reply) {
      typing.remove();
      addMsg(reply, 'bot');
    }, function () {
      typing.remove();
      addBotReplyLocal(q);
    });
    return;
  }
  addBotReplyLocal(q);
}
function addBotReplyLocal(q) {
  const q2 = q.toLowerCase();
  let reply = "Je ne dispose pas encore d'une information officielle suffisante sur ce point. Je peux toutefois transmettre votre demande à l'équipe IBIG Soft ou vous orienter vers le support.";
  if (q2.includes('secretis') || q2.includes('fait') || q2.includes('quoi')) {
    reply = "SECRETIS ERP est une solution complète de gestion du courrier, des visiteurs et du secrétariat. Elle centralise, automatise et trace toute l'activité de votre secrétariat. Souhaitez-vous une démonstration ?";
  } else if (q2.includes('prix') || q2.includes('combien') || q2.includes('tarif') || q2.includes('coûte')) {
    reply = "Les tarifs SECRETIS ERP sont disponibles sur devis selon la taille de votre structure et les modules souhaités. Contactez-nous pour une offre personnalisée.";
  } else if (q2.includes('essai') || q2.includes('gratuit') || q2.includes('tester')) {
    reply = "Oui ! SECRETIS ERP propose un essai gratuit de 14 jours, sans carte bancaire. Cliquez sur « Essai gratuit » pour commencer immédiatement.";
  } else if (q2.includes('demo') || q2.includes('démonstration') || q2.includes('démo')) {
    reply = "Vous pouvez demander une démonstration personnalisée. Notre équipe IBIG Soft vous présentera SECRETIS ERP en fonction de vos besoins. Souhaitez-vous que je vous y oriente ?";
  } else if (q2.includes('install') || q2.includes('mobile') || q2.includes('pwa') || q2.includes('téléphone')) {
    reply = "SECRETIS ERP est installable sur votre smartphone ou tablette comme une application (PWA). Sur Android, cliquez sur « Ajouter à l'écran d'accueil ». Sur iPhone, touchez Partager puis « Ajouter à l'écran d'accueil ».";
  } else if (q2.includes('support') || q2.includes('aide') || q2.includes('problème') || q2.includes('contact')) {
    reply = "Notre équipe de support est disponible par ticket depuis votre espace SECRETIS. Vous pouvez aussi nous écrire à secretis@ibigsoft.com. Puis-je vous aider autrement ?";
  }
  addMsg(reply, 'bot');
}

// ─── PWA ─────────────────────────────────────────────────────
let deferredPrompt = null;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  const dismissed = localStorage.getItem('pwa-dismissed');
  if (!dismissed) {
    setTimeout(() => {
      document.getElementById('pwa-banner').classList.add('show');
    }, 4000);
  }
  document.getElementById('install-btn').style.display = 'inline-flex';
  document.getElementById('pwa-hint').style.display = 'none';
});
function installPwa() {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(c => {
    deferredPrompt = null;
    dismissPwa();
  });
}
function dismissPwa() {
  document.getElementById('pwa-banner').classList.remove('show');
  localStorage.setItem('pwa-dismissed', '1');
}
window.addEventListener('appinstalled', () => dismissPwa());

// ─── Cookies ─────────────────────────────────────────────────
function acceptCookies() { localStorage.setItem('cookies', 'all'); document.getElementById('cookie-banner').classList.remove('show'); }
function refuseCookies() { localStorage.setItem('cookies', 'essential'); document.getElementById('cookie-banner').classList.remove('show'); }
if (!localStorage.getItem('cookies')) {
  setTimeout(() => document.getElementById('cookie-banner').classList.add('show'), 1500);
}

// ─── Smooth anchor offset ────────────────────────────────────
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) {
      e.preventDefault();
      const offset = 80;
      window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' });
    }
  });
});

// ─── Responsive demo grid ─────────────────────────────────────
function fixDemoGrids() {
  document.querySelectorAll('.demo-grid').forEach(g => {
    g.style.gridTemplateColumns = window.innerWidth < 768 ? '1fr' : '1fr 1fr';
  });
}
fixDemoGrids();
window.addEventListener('resize', fixDemoGrids);
</script>

<script>
/* SARA — branchement API Groq (remplace le Q&A local) */
(function () {
  var saraHistory = [];
  window.saraAskApi = function (message, onReply, onError) {
    fetch('/api/sara/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ message: message, history: saraHistory.slice(-8) })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var reply = (d && d.reply) ? d.reply : null;
        if (!reply) throw new Error('empty');
        saraHistory.push({ role: 'user', content: message });
        saraHistory.push({ role: 'assistant', content: reply });
        onReply(reply);
      })
      .catch(function () {
        if (onError) onError();
        else onReply("Je rencontre un souci technique. Écrivez-nous à secretis@ibigsoft.com !");
      });
  };
})();
</script>
