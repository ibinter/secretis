# =============================================================================
# IBIG SECRETIS ERP — Variables d'environnement PRODUCTION
# =============================================================================
# Fichier : .env.production.example
# Version : 1.0.0
# Auteur  : IBIG SOFT
#
# IMPORTANT :
#   - Copier ce fichier en .env et renseigner toutes les valeurs vides
#   - Ne JAMAIS committer le fichier .env réel dans Git
#   - Utiliser un gestionnaire de secrets (Vault, AWS SSM) en production
#   - Toutes les valeurs marquées REQUIRED doivent être renseignées
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="IBIG SECRETIS"
APP_ENV=production
APP_KEY=                                    # REQUIRED : php artisan key:generate
APP_DEBUG=false
APP_URL=https://app.secretis.ibigsoft.com
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
SECRETIS_VERSION=1.0.0

# =============================================================================
# BASE DE DONNÉES POSTGRESQL
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=                                    # REQUIRED : IP ou hostname PostgreSQL
DB_PORT=5432
DB_DATABASE=secretis_production
DB_USERNAME=                                # REQUIRED
DB_PASSWORD=                                # REQUIRED : mot de passe fort (32+ car.)
DB_SCHEMA=public
DB_SSLMODE=require
DB_POOL_MIN=5
DB_POOL_MAX=20

# Read replica (optionnel, pour les requêtes de lecture lourdes)
DB_READ_HOST=
DB_READ_PORT=5432

# =============================================================================
# REDIS (Cache, Sessions, Queues, Broadcasting)
# =============================================================================
REDIS_HOST=                                 # REQUIRED : IP ou hostname Redis
REDIS_PASSWORD=                             # REQUIRED : AUTH password Redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_TLS=true
REDIS_PREFIX=secretis_

# =============================================================================
# CACHE & SESSIONS
# =============================================================================
CACHE_DRIVER=redis
CACHE_PREFIX=secretis_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=480                        # 8 heures en minutes
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# =============================================================================
# QUEUE (Files de travaux asynchrones)
# =============================================================================
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database
QUEUE_DEFAULT=default
QUEUE_HIGH=high
QUEUE_LOW=low
QUEUE_NOTIFICATIONS=notifications
QUEUE_REPORTS=reports

# =============================================================================
# BROADCASTING (WebSocket Reverb temps-réel)
# =============================================================================
BROADCAST_DRIVER=reverb

REVERB_APP_ID=                              # REQUIRED : ID unique application Reverb
REVERB_APP_KEY=                             # REQUIRED : Clé publique Reverb
REVERB_APP_SECRET=                          # REQUIRED : Secret Reverb (32+ car.)
REVERB_HOST=reverb.secretis.ibigsoft.com
REVERB_PORT=443
REVERB_SCHEME=https

# Côté frontend (Vite/Vue)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =============================================================================
# MESSAGERIE EMAIL (SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=                                  # REQUIRED : smtp.sendgrid.net ou équivalent
MAIL_PORT=587
MAIL_USERNAME=                              # REQUIRED
MAIL_PASSWORD=                              # REQUIRED
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@secretis.ibigsoft.com
MAIL_FROM_NAME="IBIG SECRETIS"

# Queue dédiée pour les emails (évite blocages)
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_NAME=notifications

# =============================================================================
# STOCKAGE FICHIERS (S3 Compatible — AWS / Cloudflare R2 / MinIO)
# =============================================================================
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=                          # REQUIRED
AWS_SECRET_ACCESS_KEY=                      # REQUIRED
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=secretis-documents
AWS_URL=                                    # URL publique CDN (si applicable)
AWS_ENDPOINT=                               # Endpoint custom (Cloudflare R2, MinIO)
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stockage temporaire local (OCR, exports PDF, etc.)
LOCAL_TEMP_DISK=local

# =============================================================================
# SAUVEGARDES (Bucket dédié séparé des documents)
# =============================================================================
BACKUP_S3_BUCKET=secretis-backups
BACKUP_S3_REGION=eu-west-1
BACKUP_S3_KEY=                              # REQUIRED (accès restreint bucket backup)
BACKUP_S3_SECRET=                           # REQUIRED
BACKUP_ENCRYPTION_KEY=                      # REQUIRED : clé AES-256 (32 octets base64)
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFICATION_EMAIL=admin@ibigsoft.com

# =============================================================================
# INTELLIGENCE ARTIFICIELLE (SARA)
# =============================================================================
AI_DEFAULT_PROVIDER=groq

# Groq (provider principal — rapide et économique)
GROQ_API_KEY=                               # REQUIRED
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.3

# OpenAI (fallback premium)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# Anthropic Claude (fallback pour tâches complexes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Cache des réponses IA (réduit les coûts)
AI_CACHE_TTL=3600

# =============================================================================
# PAIEMENTS MOBILES & SOLUTIONS AFRICAINES
# =============================================================================

# CinetPay (Côte d'Ivoire, Sénégal, Cameroun, etc.)
CINETPAY_API_KEY=                           # REQUIRED pour paiements CI/SN/CM
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# Paystack (Nigeria, Ghana, Afrique du Sud, Kenya)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave (Pan-africain)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Orange Money (UEMOA)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_KEY=

# MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=production

# =============================================================================
# WHATSAPP BUSINESS API
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=                   # REQUIRED si module WhatsApp activé
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=                      # Token pour la vérification webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# =============================================================================
# INTÉGRATION GOOGLE (Calendar, Drive)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.secretis.ibigsoft.com/integrations/google/callback

# =============================================================================
# INTÉGRATION MICROSOFT 365 (Outlook, Teams, OneDrive)
# =============================================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://app.secretis.ibigsoft.com/integrations/microsoft/callback
MICROSOFT_SCOPES="User.Read Calendars.ReadWrite Contacts.ReadWrite Mail.ReadWrite"

# =============================================================================
# PUSH NOTIFICATIONS (Service Worker PWA / VAPID)
# =============================================================================
VAPID_PUBLIC_KEY=                           # REQUIRED : généré via web-push
VAPID_PRIVATE_KEY=                          # REQUIRED
VAPID_SUBJECT=mailto:noreply@secretis.ibigsoft.com

# =============================================================================
# MONITORING & OBSERVABILITÉ
# =============================================================================
MONITORING_ADMIN_EMAIL=admin@ibigsoft.com
SLACK_LOG_WEBHOOK_URL=                      # Webhook Slack pour alertes critiques
SENTRY_DSN=                                 # DSN Sentry pour le suivi d'erreurs
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# Métriques IP (accès restreint au dashboard monitoring)
METRICS_IP_WHITELIST=                       # IPs autorisées séparées par virgule
GRAFANA_URL=https://grafana.secretis.ibigsoft.com

# Health Check
HEALTH_CHECK_SECRET=                        # Token pour l'endpoint /health

# =============================================================================
# TAUX DE CHANGE
# =============================================================================
OPEN_EXCHANGE_RATES_APP_ID=                 # REQUIRED si module comptabilité multi-devises
EXCHANGE_RATES_CACHE_TTL=3600
BASE_CURRENCY=XOF

# =============================================================================
# SIGNATURE ÉLECTRONIQUE
# =============================================================================
SIGNATURE_CERTIFICATE_PATH=/etc/secretis/certs/signature.crt
SIGNATURE_PRIVATE_KEY_PATH=/etc/secretis/certs/signature.key
SIGNATURE_CERTIFICATE_PASSWORD=            # Mot de passe du certificat P12

# =============================================================================
# OCR (Reconnaissance Optique de Caractères)
# =============================================================================
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=fra+eng
OCR_TEMP_PATH=/tmp/secretis-ocr
OCR_TIMEOUT=60

# =============================================================================
# LDAP / ACTIVE DIRECTORY (Entreprises avec annuaire interne)
# =============================================================================
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_USE_TLS=true
LDAP_USER_FILTER=(objectClass=person)

# =============================================================================
# SSO (Single Sign-On — SAML / OAuth)
# =============================================================================
SSO_ENFORCE=false                           # Mettre à true pour forcer le SSO
SAML_SP_ENTITY_ID=https://app.secretis.ibigsoft.com
SAML_SP_ACS_URL=https://app.secretis.ibigsoft.com/sso/saml/acs
SAML_SP_PRIVATE_KEY=
SAML_SP_CERTIFICATE=

# =============================================================================
# LICENCE ON-PREMISE (pour installations dédiées hors SaaS)
# =============================================================================
SECRETIS_LICENSE_KEY=                       # REQUIRED uniquement en mode on-premise
IBIGSOFT_PUBLIC_KEY_PATH=/etc/secretis/ibigsoft-public.key
LICENSE_VERIFICATION_URL=https://license.ibigsoft.com/api/v1/verify

# =============================================================================
# SÉCURITÉ
# =============================================================================
BCRYPT_ROUNDS=12
API_RATE_LIMIT=1000                         # Requêtes par heure par API key
WEBHOOK_RATE_LIMIT=10                       # Webhooks entrants par minute
TRUSTED_PROXIES=*                           # IPs des reverse proxies de confiance
CORS_ALLOWED_ORIGINS=https://app.secretis.ibigsoft.com

# Content Security Policy
CSP_ENABLED=true

# 2FA obligatoire pour les admins
FORCE_2FA_ADMINS=true

# =============================================================================
# SUPER ADMINISTRATION
# =============================================================================
SUPERADMIN_EMAIL=superadmin@ibigsoft.com
SUPERADMIN_IP_WHITELIST=                    # IPs autorisées pour le super admin

# =============================================================================
# MODE DÉMO
# =============================================================================
APP_DEMO_MODE=false
DEMO_RESET_INTERVAL=24                      # Heures entre chaque reset des données démo

# =============================================================================
# PLANIFICATEUR DE TÂCHES (CRON)
# =============================================================================
SCHEDULE_TIMEZONE=Africa/Abidjan
SCHEDULE_CACHE_DRIVER=redis

# =============================================================================
# LOGS
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL="${SLACK_LOG_WEBHOOK_URL}"
LOG_DAILY_DAYS=14

# =============================================================================
# PERFORMANCE
# =============================================================================
OCTANE_SERVER=swoole                        # ou roadrunner
OPCACHE_ENABLED=true
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# =============================================================================
# CONFIGURATION FRONTEND (injectée lors du build Vite)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_APP_LOCALE="${APP_LOCALE}"
VITE_SECRETIS_VERSION="${SECRETIS_VERSION}"
