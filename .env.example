# =============================================================================
# SECRETIS ERP - Fichier d'environnement exemple
# Copiez ce fichier en .env et remplissez toutes les valeurs
# Ne committez JAMAIS le fichier .env dans Git
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="SECRETIS ERP"
APP_ENV=production         # local | staging | production
APP_KEY=                   # Générer avec : php artisan key:generate
APP_DEBUG=false            # TOUJOURS false en production
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_URL=https://secretis.ibigsoft.com
APP_VERSION=1.0.0

# Mode de log : stack | single | daily | slack | stderr | syslog | errorlog
LOG_CHANNEL=daily
LOG_LEVEL=error            # debug | info | notice | warning | error | critical
LOG_DEPRECATIONS_CHANNEL=null
LOG_STACK=daily            # Canaux pour le channel "stack"

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES POSTGRESQL
# ─────────────────────────────────────────────────────────────────────────────

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1          # En Docker : postgres
DB_PORT=5432
DB_DATABASE=secretis_production
DB_USERNAME=secretis_db
DB_PASSWORD=                # Mot de passe fort - ne JAMAIS laisser vide

# Pool de connexions (pour Laravel Octane ou pgBouncer)
DB_POOL_MIN=5
DB_POOL_MAX=20

# Second DB pour la lecture (optionnel, read replica)
# DB_READ_HOST=replica.secretis.ibigsoft.com
# DB_READ_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Cache, Sessions, Queues)
# ─────────────────────────────────────────────────────────────────────────────

REDIS_HOST=127.0.0.1       # En Docker : redis
REDIS_PASSWORD=             # Mot de passe fort
REDIS_PORT=6379
REDIS_DB=0

# Base de données Redis séparée par usage
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_BROADCAST_DB=4

# ─────────────────────────────────────────────────────────────────────────────
# CACHE
# ─────────────────────────────────────────────────────────────────────────────

CACHE_STORE=redis
CACHE_PREFIX=secretis_erp
CACHE_TTL=3600             # Durée par défaut en secondes

# ─────────────────────────────────────────────────────────────────────────────
# SESSIONS
# ─────────────────────────────────────────────────────────────────────────────

SESSION_DRIVER=redis
SESSION_LIFETIME=120       # Minutes
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.secretis.ibigsoft.com  # Point devant = valide pour sous-domaines
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# QUEUES
# ─────────────────────────────────────────────────────────────────────────────

QUEUE_CONNECTION=database  # database | redis | sqs
# Queues disponibles : default, emails, broadcasts, exports
QUEUE_FAILED_DRIVER=database-uuids

# ─────────────────────────────────────────────────────────────────────────────
# MAIL (Email transactionnel)
# ─────────────────────────────────────────────────────────────────────────────

MAIL_MAILER=smtp           # smtp | ses | mailgun | postmark | sendgrid | log | array
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=             # Votre identifiant SMTP
MAIL_PASSWORD=             # Votre mot de passe SMTP
MAIL_FROM_ADDRESS=noreply@ibigsoft.com
MAIL_FROM_NAME="SECRETIS ERP"

# Adresse de réponse (optionnel)
MAIL_REPLY_TO=support@ibigsoft.com

# Clés Mailgun (si MAIL_MAILER=mailgun)
# MAILGUN_DOMAIN=mg.ibigsoft.com
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# ─────────────────────────────────────────────────────────────────────────────
# LARAVEL REVERB (WebSocket temps réel)
# ─────────────────────────────────────────────────────────────────────────────

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=secretis-erp-001
REVERB_APP_KEY=             # Clé publique Reverb (générer une chaîne unique)
REVERB_APP_SECRET=          # Secret Reverb (générer une chaîne secrète)
REVERB_HOST=127.0.0.1       # En Docker : reverb | En externe : secretis.ibigsoft.com
REVERB_PORT=8080
REVERB_SCHEME=http          # http en interne (Nginx gère HTTPS en frontal)

# Config côté client JavaScript (Vite expose ces vars)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_URL="${APP_URL}"

# ─────────────────────────────────────────────────────────────────────────────
# STOCKAGE FICHIERS - S3 Compatible (AWS S3 ou Cloudflare R2)
# ─────────────────────────────────────────────────────────────────────────────

FILESYSTEM_DISK=s3         # local | s3 | r2

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=secretis-files
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=                   # URL publique du bucket (si CloudFront)

# Cloudflare R2 (compatible S3)
# Remplace les variables AWS_ ci-dessus pour utiliser R2 :
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET>
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=secretis-files
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Bucket dédié aux sauvegardes (isolation des droits) ─────────────────────
BACKUP_DISK=s3_backup
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=secretis-backups
BACKUP_S3_ENDPOINT=         # URL endpoint R2 ou S3

# Chiffrement des sauvegardes (AES-256-CBC) - OBLIGATOIRE en production
BACKUP_ENCRYPTION_KEY=      # openssl rand -base64 32

# ─────────────────────────────────────────────────────────────────────────────
# IA SARA - Intelligence Artificielle SECRETIS
# SARA = Système d'Aide et de Recherche Automatisé
# ─────────────────────────────────────────────────────────────────────────────

# Provider IA principal
AI_PROVIDER=groq            # groq | openai | anthropic | ollama

# Groq (LLaMA ultra-rapide, recommandé pour le temps réel)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# OpenAI (GPT-4, pour les tâches complexes)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=4096

# Anthropic Claude (raisonnement avancé)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=8192

# Ollama (modèle local, pour environnements sans internet)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Paramètres SARA globaux
SARA_ENABLED=true
SARA_MAX_CONTEXT_LENGTH=50000
SARA_MEMORY_ENABLED=true
SARA_EMBEDDING_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# PAIEMENTS
# ─────────────────────────────────────────────────────────────────────────────

# ── CinetPay (Afrique de l'Ouest - UEMOA) ────────────────────────────────────
CINETPAY_ENABLED=true
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_MODE=PRODUCTION    # PRODUCTION | TEST
CINETPAY_CURRENCY=XOF       # XOF | XAF | GNF | USD

# ── Paystack (Nigeria, Ghana, Afrique du Sud, Kenya) ─────────────────────────
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# ── Orange Money API ──────────────────────────────────────────────────────────
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CURRENCY=XOF
ORANGE_MONEY_CALLBACK_URL="${APP_URL}/webhooks/orange-money"

# ── MTN MoMo (Mobile Money) ───────────────────────────────────────────────────
MTN_MOMO_ENABLED=false
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=production  # sandbox | production
MTN_MOMO_CURRENCY=XOF

# ─────────────────────────────────────────────────────────────────────────────
# SMS & WHATSAPP
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+225XXXXXXXXXX

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # Token pour vérifier les webhooks Meta
WHATSAPP_API_VERSION=v18.0

# ── AfricasTalking (SMS Afrique) ──────────────────────────────────────────────
AFRICAS_TALKING_ENABLED=false
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=SECRETIS

# ─────────────────────────────────────────────────────────────────────────────
# SUPERADMIN IBIG SOFT
# ─────────────────────────────────────────────────────────────────────────────

# Compte superadmin pour la gestion globale de la plateforme SaaS
SUPERADMIN_EMAIL=admin@ibigsoft.com
SUPERADMIN_NAME="IBIG SOFT Admin"

# Token d'accès superadmin (NE JAMAIS partager)
SUPERADMIN_TOKEN=           # Générer : php artisan secretis:generate-superadmin-token

# Plages IP autorisées pour le panneau superadmin (séparées par des virgules)
# Laisser vide = aucune restriction (déconseillé en production)
SUPERADMIN_ALLOWED_IPS=

# Clé secrète pour les opérations critiques (2FA superadmin)
SUPERADMIN_SECRET=          # openssl rand -base64 32

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS & ALERTES SYSTÈME
# ─────────────────────────────────────────────────────────────────────────────

# Slack pour les alertes de déploiement et erreurs critiques
SLACK_WEBHOOK_URL=          # https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_BOT_TOKEN=            # xoxb-xxx (pour les notifications riches)
SLACK_CHANNEL=#secretis-alerts

# Email des alertes système
DEPLOY_NOTIFY_EMAIL=devops@ibigsoft.com

# Sentry (monitoring d'erreurs)
SENTRY_LARAVEL_DSN=         # https://xxx@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANT (SaaS)
# ─────────────────────────────────────────────────────────────────────────────

# Domaine principal de la plateforme
TENANT_DOMAIN=secretis.ibigsoft.com

# Stratégie d'identification des tenants : subdomain | header | path
TENANT_IDENTIFICATION=subdomain

# Durée d'essai gratuit (jours)
TRIAL_DAYS=14

# Plans disponibles (slugs)
PLANS_AVAILABLE=starter,business,enterprise

# ─────────────────────────────────────────────────────────────────────────────
# SECURITE
# ─────────────────────────────────────────────────────────────────────────────

# Durée de validité des tokens API (minutes)
SANCTUM_STATEFUL_DOMAINS=secretis.ibigsoft.com,*.secretis.ibigsoft.com
PERSONAL_ACCESS_TOKEN_TTL=43200  # 30 jours en minutes

# Rate limiting API (requêtes par minute par IP)
API_RATE_LIMIT=60
WEBHOOK_RATE_LIMIT=10

# Chiffrement des données sensibles en BDD
APP_CIPHER=AES-256-CBC

# ─────────────────────────────────────────────────────────────────────────────
# SERVICES TIERS DIVERS
# ─────────────────────────────────────────────────────────────────────────────

# MeiliSearch (recherche plein texte)
SCOUT_DRIVER=meilisearch    # meilisearch | algolia | database | null
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=            # Clé maître MeiliSearch

# Google OAuth (connexion avec Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Mapbox / Google Maps (cartographie pour véhicules)
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=

# Pusher (alternative à Reverb si besoin)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=eu
