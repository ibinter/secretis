{
  "name": "secretis-erp-e2e",
  "version": "1.0.0",
  "description": "Tests E2E Playwright pour IBIG SECRETIS ERP",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",

    "test:setup": "playwright test --project=setup --project=legacy-setup",

    "test:auth": "playwright test tests/auth.spec.ts",
    "test:agenda": "playwright test tests/agenda.spec.ts",
    "test:courrier": "playwright test tests/courrier.spec.ts",
    "test:taches": "playwright test tests/taches.spec.ts",
    "test:visiteurs": "playwright test tests/visiteurs.spec.ts",
    "test:paiement": "playwright test tests/paiement.spec.ts",
    "test:pwa": "playwright test tests/pwa.spec.ts",

    "test:roles": "playwright test roles/",
    "test:role:superadmin": "playwright test roles/superadmin.spec.ts",
    "test:role:admin": "playwright test roles/admin.spec.ts",
    "test:role:secretaire": "playwright test roles/secretaire.spec.ts",
    "test:role:dirigeant": "playwright test roles/dirigeant.spec.ts",
    "test:role:auditeur": "playwright test roles/auditeur.spec.ts",
    "test:role:rh": "playwright test roles/rh_manager.spec.ts",
    "test:role:comptable": "playwright test roles/comptable.spec.ts",
    "test:role:chef-projet": "playwright test roles/chef_projet.spec.ts",
    "test:role:qualite": "playwright test roles/technicien_qualite.spec.ts",
    "test:role:visiteur": "playwright test roles/visiteur_externe.spec.ts",

    "test:security": "playwright test security/",
    "test:multitenancy": "playwright test security/multitenancy.spec.ts tests/multitenancy.spec.ts",
    "test:payments": "playwright test security/payments.spec.ts tests/paiement.spec.ts",

    "test:features": "playwright test features/",
    "test:search": "playwright test features/search.spec.ts",
    "test:notifications": "playwright test features/notifications.spec.ts",
    "test:sara": "playwright test features/sara.spec.ts tests/sara.spec.ts",
    "test:academy": "playwright test features/academy.spec.ts",

    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8000",
    "install:browsers": "playwright install --with-deps"
  },
  "dependencies": {
    "otpauth": "^9.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
