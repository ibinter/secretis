{
  "name": "secretis-erp-e2e",
  "version": "1.0.0",
  "description": "Tests E2E Playwright pour IBIG SECRETIS ERP",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:auth": "playwright test auth.spec.ts",
    "test:agenda": "playwright test agenda.spec.ts",
    "test:courrier": "playwright test courrier.spec.ts",
    "test:taches": "playwright test taches.spec.ts",
    "test:visiteurs": "playwright test visiteurs.spec.ts",
    "test:paiement": "playwright test paiement.spec.ts",
    "test:multitenancy": "playwright test multitenancy.spec.ts",
    "test:sara": "playwright test sara.spec.ts",
    "test:pwa": "playwright test pwa.spec.ts",
    "test:setup": "playwright test --project=setup",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8000",
    "install:browsers": "playwright install --with-deps"
  },
  "dependencies": {
    "otpauth": "^9.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
