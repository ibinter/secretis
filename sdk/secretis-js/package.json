{
  "name": "@ibigsoft/secretis-js",
  "version": "1.0.0",
  "description": "SDK JavaScript officiel pour l'API IBIG SECRETIS ERP",
  "author": "IBIG Soft <dev@ibigsoft.com>",
  "license": "UNLICENSED",
  "homepage": "https://secretis.ibigsoft.com/docs/sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibigsoft/secretis-js.git"
  },
  "bugs": {
    "url": "https://github.com/ibigsoft/secretis-js/issues",
    "email": "support@ibigsoft.com"
  },
  "keywords": ["secretis", "ibig", "erp", "api", "sdk", "africa"],

  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],

  "scripts": {
    "build": "tsc && tsc --module ESNext --outDir dist/esm",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },

  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },

  "engines": {
    "node": ">=16.0.0"
  }
}
